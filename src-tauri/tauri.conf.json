{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ensō Time",
  "version": "0.1.0-beta.1",
  "identifier": "os.enso.time",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ensō Time",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Mateo (@mateofh)",
    "shortDescription": "Private time diagnosis and automation guidance",
    "longDescription": "Ensō Time observes desktop activity locally, asks for missing context, and produces evidence-based productivity and automation guidance.",
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "https://timestamp.digicert.com"
    }
  }
}
